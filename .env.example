# ============================================================
#  ONLINE SAVDO — Muhit o'zgaruvchilari namunasi
#  Nusxa oling:  cp .env.example .env
#  .env fayli hech qachon git-ga qo'shilmaydi (xavfsizlik!)
# ============================================================

# --- Django ---
# PRODUCTION uchun kuchli tasodifiy kalit: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=dev-faqat-ushbu-kalitni-ozgartiring-1234567890
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Ma'lumotlar bazasi ---
# Dev (standart): SQLite ishlatiladi — DATABASE_URL ni bo'sh qoldiring
# Prod:  DATABASE_URL=postgresql://shop_user:secret@db:5432/shop
DATABASE_URL=

# --- CORS: frontend manzili (faqat shu manbaga ruxsat) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Telegram bot (ixtiyoriy — bo'sh bo'lsa kod konsolga yoziladi) ---
BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MyShopBot
# Webhook to'liq manzili (production): https://yourdomain.com
WEBHOOK_BASE_URL=
ADMIN_TELEGRAM_CHAT_IDS=            # vergul bilan ajratilgan: 123456789,987654321

# --- Background tasklar ---
# Devda Celery/Redis yo'q bo'lsa False qoldiring (xabarlar sinxron yuboriladi)
USE_CELERY=False
BROKER_URL=redis://127.0.0.1:6379/0

# --- Demo ma'lumotlar (seed_demo) ---
DEMO_ADMIN_PHONE=998901234567
DEMO_ADMIN_PASSWORD=Admin@123456
DEMO_USER_PHONE=998901234568
DEMO_USER_PASSWORD=User@123456
